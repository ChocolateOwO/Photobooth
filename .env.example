# Instance settings template. Real files live OUTSIDE the repo:
#   Dummy\config\photobooth.env  (created by scripts\run-dummy.ps1 via `photobooth init-env`)
# Never commit a populated copy.
PHOTOBOOTH_INSTANCE=dummy
PHOTOBOOTH_PROFILE=dev
PHOTOBOOTH_INSTANCE_ROOT=<absolute path to the Dummy folder>
PHOTOBOOTH_KIOSK_HOST=127.0.0.1
PHOTOBOOTH_KIOSK_PORT=8111
PHOTOBOOTH_DELIVERY_HOST=0.0.0.0
PHOTOBOOTH_DELIVERY_PORT=8113
# Phase 3+ (admin auth). Leave empty in the template.
PHOTOBOOTH_ADMIN_PASSWORD=
